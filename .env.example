# Data adapter, read only by adapterMode() in lib/config.ts.
# fake serves the seed sites and their stored day profiles with no network.
# real calls the keyless Open-Meteo forecast, archive and geocoding APIs from the server,
# and falls back to the seed profile if a call fails. Default when unset: real.
# No API key exists for any of the three APIs, so this is the only setting.
# Set ADAPTER_MODE=fake for offline development or tests with no network.
ADAPTER_MODE=real

# Phase 3 (browser store, demo reset, hours cache) added no env variable.

# Public base URL of the deploy, read only by SITE_URL in lib/config.ts. Used for metadataBase
# and the crew sheet QR code. Public by design, not a secret. Default when unset: the value below.
NEXT_PUBLIC_SITE_URL=https://calidra.vercel.app

# NEXT_PUBLIC_BRAND_FILES is set automatically by next.config.ts at build time; do not set it by hand.
# NEXT_PUBLIC_BRAND_FILES=
